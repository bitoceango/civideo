// 复制为 wrangler.jsonc 并填入你自己的值后再 deploy。
// wrangler.jsonc 已被 .gitignore 忽略，不会进开源仓库。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "child-video-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "routes": [
    // 换成你自己托管在 Cloudflare 的域名（不要用 *.workers.dev，国内无法直连）
    { "pattern": "video.example.com", "custom_domain": true }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "child-video" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "child-video-db",
      // `npx wrangler d1 create child-video-db` 后把返回的 database_id 填这里
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  "observability": { "enabled": true }
}

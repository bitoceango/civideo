// 推荐用 `npm run setup` 自动生成 wrangler.jsonc（建桶/建库/写回 id/部署）。
// 若想手动配置：复制本文件为 wrangler.jsonc 并填好后再 deploy。
// wrangler.jsonc 已被 .gitignore 忽略，不会进开源仓库。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "child-video-api",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",

  // 默认用免费的 *.workers.dev 子域，零域名即可部署。
  // ⚠️ *.workers.dev 在中国大陆可能被墙；需要稳定访问就改用自定义域名（见下方）。
  "workers_dev": true,

  // 自定义域名（可选）：把上面 workers_dev 改成 false，并取消下面注释、填你托管在 Cloudflare 的域名。
  // "routes": [
  //   { "pattern": "video.example.com", "custom_domain": true }
  // ],

  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "child-video" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "child-video-db",
      // `npx wrangler d1 create child-video-db` 后把返回的 database_id 填这里（npm run setup 会自动填）
      "database_id": "<YOUR_D1_DATABASE_ID>"
    }
  ],
  "observability": { "enabled": true }
}
